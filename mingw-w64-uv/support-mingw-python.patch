+    elif operating_system.startswith("mingw_"):
+        # MSYS2's CPython is a Windows interpreter built by a MinGW
+        # toolchain. It reports `mingw_{arch}` with optional CRT and
+        # compiler suffixes rather than `win-{arch}`, e.g.
+        # `mingw_x86_64_ucrt_gnu` (UCRT64), `mingw_x86_64` (MINGW64),
+        # `mingw_i686` (MINGW32) or `mingw_aarch64_ucrt_llvm`
+        # (CLANGARM64). The string carries no `-`, so the split above
+        # left the whole of it here and the architecture empty.
+        #
+        # 32-bit MinGW reports `i686`, so there is deliberately no bare
+        # `x86` entry: it would swallow the `x86` of a malformed
+        # `x86_64...` as a 32-bit build.
+        remainder = operating_system[len("mingw_") :]
+        for name, mingw_architecture in (
+            ("x86_64", "x86_64"),
+            ("aarch64", "aarch64"),
+            ("arm64", "aarch64"),
+            ("i686", "i686"),
+        ):
+            if remainder == name or remainder.startswith(name + "_"):
+                architecture = mingw_architecture
+                break
+        else:
+            print(
+                json.dumps(
+                    {
+                        "result": "error",
+                        "kind": "unknown_operating_system",
+                        "operating_system": operating_system,
+                    }
+                )
+            )
+            sys.exit(0)
+        operating_system = {
+            "name": "windows",
+        }
     else:
